<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/alumno_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Tarjeta del QR - Estilo Flotante y Limpio -->
        <com.google.android.material.card.MaterialCardView
            style="@style/QRAsist.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:id="@+id/tv_nombre_alumno_qr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textSize="24sp"
                    android:textColor="@color/alumno_primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_matricula_alumno_qr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    android:gravity="center"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:letterSpacing="0.05" />

                <ImageView
                    android:id="@+id/iv_codigo_qr"
                    android:layout_width="260dp"
                    android:layout_height="260dp"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:layout_marginBottom="20dp" />

                <Button
                    android:id="@+id/btn_compartir_qr"
                    style="@style/QRAsist.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_compartir_qr"
                    android:textColor="@color/alumno_primary"
                    app:icon="@android:drawable/ic_menu_share"
                    app:iconTint="@color/alumno_primary"
                    app:strokeColor="@color/alumno_primary"
                    app:strokeWidth="1dp"
                    android:backgroundTint="@android:color/transparent" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:layout_gravity="start"
            android:layout_marginStart="8dp"
            android:text="Mi historial de asistencias"
            android:textSize="18sp"
            android:textColor="@color/text_primary_alumno"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_historial_alumno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipToPadding="false"
            android:paddingBottom="24dp"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</ScrollView>