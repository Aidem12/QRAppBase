<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Estilos Base -->
    <style name="QRAsist" />
    <style name="QRAsist.Text" parent="android:Widget.TextView" />
    
    <!-- Cards Modernas -->
    <style name="QRAsist.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="android:layout_margin">8dp</item>
    </style>

    <!-- Cards de Estadísticas -->
    <style name="QRAsist.Card.Stats" parent="QRAsist.Card">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">4dp</item>
        <item name="android:layout_margin">6dp</item>
    </style>

    <!-- Botones Ejecutivos -->
    <style name="QRAsist.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Botones Outlined Dinámicos -->
    <style name="QRAsist.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textAllCaps">false</item>
        <item name="iconTint">?attr/colorPrimary</item>
    </style>

    <!-- Toolbar Adaptable (Maestro/Alumno) -->
    <style name="QRAsist.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextColor">@android:color/white</item>
        <item name="android:background">?attr/colorPrimary</item>
        <item name="background">?attr/colorPrimary</item>
        <item name="titleTextAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="navigationIconTint">@android:color/white</item>
    </style>

    <!-- AppBarLayout Style -->
    <style name="QRAsist.AppBarLayout" parent="Widget.Material3.AppBarLayout">
        <item name="android:background">?attr/colorPrimary</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- FAB Maestro -->
    <style name="QRAsist.FAB" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/maestro_primary</item>
        <item name="tint">@color/maestro_on_primary</item>
    </style>

    <!-- Inputs Modernos -->
    <style name="QRAsist.TextInputLayout" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/input_background</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="startIconTint">@color/text_secondary</item>
    </style>

    <!-- Chips de Estado -->
    <style name="QRAsist.Chip.Status" parent="Widget.Material3.Chip.Assist">
        <item name="chipCornerRadius">24dp</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Chip Item -->
    <style name="QRAsist.Chip.Item" parent="QRAsist.Chip.Status">
        <item name="chipBackgroundColor">@color/maestro_primary_light</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="QRAsist.Chip.Asistio" parent="QRAsist.Chip.Status">
        <item name="chipBackgroundColor">@color/estado_asistio_bg</item>
        <item name="android:textColor">@color/estado_asistio_text</item>
    </style>

    <style name="QRAsist.Chip.Retardo" parent="QRAsist.Chip.Status">
        <item name="chipBackgroundColor">@color/estado_retardo_bg</item>
        <item name="android:textColor">@color/estado_retardo_text</item>
    </style>

    <style name="QRAsist.Chip.Falta" parent="QRAsist.Chip.Status">
        <item name="chipBackgroundColor">@color/estado_falta_bg</item>
        <item name="android:textColor">@color/estado_falta_text</item>
    </style>

    <!-- Textos -->
    <style name="QRAsist.Text.Title" parent="QRAsist.Text">
        <item name="android:textAppearance">?attr/textAppearanceTitleLarge</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    
    <style name="QRAsist.Text.Subtitle" parent="QRAsist.Text">
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="QRAsist.Text.Body" parent="QRAsist.Text">
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="QRAsist.Text.StatNumber" parent="QRAsist.Text">
        <item name="android:textSize">32sp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="QRAsist.Text.StatLabel" parent="QRAsist.Text">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
    </style>
</resources>